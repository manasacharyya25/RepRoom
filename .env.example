NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Local MediaMTX (docker compose up -d)
# WHIP: http://localhost:8889/live/{roomId}/{userId}/whip
# HLS:  http://localhost:8888/live/{roomId}/{userId}/index.m3u8
# Archives (host): ./archives/live/{roomId}/{userId}/*.mp4
NEXT_PUBLIC_MEDIAMTX_WHIP_BASE=http://localhost:8889
NEXT_PUBLIC_MEDIAMTX_HLS_BASE=http://localhost:8888
NEXT_PUBLIC_MEDIAMTX_PLAYBACK_BASE=http://localhost:9996

# Cloudflare R2 (S3-compatible) — live preview chunk uploads
# Segment length in seconds for recorder + viewer poll (default 15, range 5–60).
NEXT_PUBLIC_PREVIEW_CHUNK_SECONDS=15
# Create credentials under R2 → Manage R2 API Tokens (Access Key + Secret)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public or r2.dev base URL (no trailing slash). CDN domain can replace this later.
R2_PUBLIC_BASE_URL=
# Same value as R2_PUBLIC_BASE_URL — required for browser chunk playback.
NEXT_PUBLIC_R2_PUBLIC_BASE_URL=

# Apply schema: run supabase/migrations/20260714120000_profiles_goals.sql
# in the Supabase SQL Editor (profiles, goals, RLS, avatars bucket).
