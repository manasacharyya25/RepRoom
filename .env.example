NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Canonical site URL for Open Graph / Twitter previews (no trailing slash).
# Example: https://rhoq.app
NEXT_PUBLIC_SITE_URL=
# Pre-launch waitlist: when true, only landing + legal + waitlist API + /onboard recorder are reachable.
WAITLIST_MODE=true

# Service role — required for /onboard/{username} recorder APIs (never expose to the browser).
SUPABASE_SERVICE_ROLE_KEY=
# Optional HMAC secret for onboard session cookies (defaults to a derivation of the service role key).
ONBOARDING_RECORDER_SECRET=

# Cloudflare R2 (S3-compatible) — live preview chunk uploads
# Segment length in seconds for recorder + viewer poll (default 15, range 5–60).
NEXT_PUBLIC_PREVIEW_CHUNK_SECONDS=15
# Drop a live session from discovery when no chunk upload within this many seconds (15–300).
# Default: 3 × NEXT_PUBLIC_PREVIEW_CHUNK_SECONDS.
NEXT_PUBLIC_LIVE_SESSION_STALE_SECONDS=
# Create credentials under R2 → Manage R2 API Tokens (Access Key + Secret)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public or r2.dev base URL (no trailing slash). CDN domain can replace this later.
R2_PUBLIC_BASE_URL=
# Same value as R2_PUBLIC_BASE_URL — required for browser chunk playback.
NEXT_PUBLIC_R2_PUBLIC_BASE_URL=

# Apply schema: run supabase/migrations/20260714120000_profiles_goals.sql
# in the Supabase SQL Editor (profiles, goals, RLS, avatars bucket).
# Waitlist: run supabase/migrations/20260726120000_waitlist_emails.sql
# Onboarding recorder: run supabase/migrations/20260726220000_onboarding_recorders.sql
#   and 20260727120000_onboarding_recorder_images.sql
#   Hash password: node scripts/hash-onboarding-password.mjs 'your-password'
