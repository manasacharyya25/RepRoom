NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Canonical site URL for Open Graph / Twitter previews (no trailing slash).
# Example: https://rhoq.app
NEXT_PUBLIC_SITE_URL=
# Pre-launch waitlist: when true, only landing + legal + waitlist API + /onboard recorder + /rhoq-admin are reachable.
WAITLIST_MODE=true

# Service role — required for /onboard/{username} recorder APIs (never expose to the browser).
SUPABASE_SERVICE_ROLE_KEY=
# Optional HMAC secret for onboard session cookies (defaults to a derivation of the service role key).
ONBOARDING_RECORDER_SECRET=

# /rhoq-admin panel password (never commit the real value).
RHOQ_ADMIN_PASSWORD=
# Optional HMAC secret for admin session cookies (defaults to a derivation of the service role key).
RHOQ_ADMIN_SECRET=

# Cloudflare R2 (S3-compatible) — live preview chunk uploads
# Segment length in seconds for recorder + viewer poll (default 15, range 5–60).
NEXT_PUBLIC_PREVIEW_CHUNK_SECONDS=15
# Drop a live session from discovery when no chunk upload within this many seconds (15–300).
# Default: 3 × NEXT_PUBLIC_PREVIEW_CHUNK_SECONDS.
NEXT_PUBLIC_LIVE_SESSION_STALE_SECONDS=
# Create credentials under R2 → Manage R2 API Tokens (Access Key + Secret)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public or r2.dev base URL (no trailing slash). CDN domain can replace this later.
R2_PUBLIC_BASE_URL=
# Same value as R2_PUBLIC_BASE_URL — required for browser chunk playback.
NEXT_PUBLIC_R2_PUBLIC_BASE_URL=

# Dodo Payments (checkout + webhooks)
# Dashboard: create products; set DODO_PRODUCT_HOUR / MONTHLY / ANNUAL to product IDs.
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
DODO_PAYMENTS_ENV=test_mode
DODO_PRODUCT_HOUR=
DODO_PRODUCT_MONTHLY=
DODO_PRODUCT_ANNUAL=
# Display prices (UI) — not product IDs. Market from browser timezone (Asia/Kolkata → IN, else WW).
DODO_PRODUCT_HOUR_WW=1
DODO_PRODUCT_MONTHLY_WW=12
DODO_PRODUCT_ANNUAL_WW=119
DODO_PRODUCT_CURRENCY_WW=$
DODO_PRODUCT_HOUR_IN=100
DODO_PRODUCT_MONTHLY_IN=499
DODO_PRODUCT_ANNUAL_IN=4999
DODO_PRODUCT_CURRENCY_IN=₹
# Webhook URL: https://<your-site>/api/billing/webhooks/dodo

# OpenAI — workout plan generation during onboarding (/api/workout-plan/generate).
# Plans are cached in workout_plan_templates by (goal, experience, days, minutes).
OPENAI_API_KEY=
# Optional model override (default: gpt-4o-mini)
OPENAI_WORKOUT_MODEL=

# Apply schema: run supabase/migrations/20260714120000_profiles_goals.sql
# in the Supabase SQL Editor (profiles, goals, RLS, avatars bucket).
# Waitlist: run supabase/migrations/20260726120000_waitlist_emails.sql
# Onboarding recorder: run supabase/migrations/20260726220000_onboarding_recorders.sql
#   and 20260727120000_onboarding_recorder_images.sql
#   and 20260727200000_onboarding_recorders_promoted.sql
#   and 20260727210000_profiles_username_match_recorder.sql
# Billing: run supabase/migrations/20260728010000_dodo_billing.sql
# Workout plan cache: run supabase/migrations/20260801150000_workout_plan_templates.sql
#   Hash password: node scripts/hash-onboarding-password.mjs 'your-password'
